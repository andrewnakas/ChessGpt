# Copy to .env (docker compose) or export in your shell. All optional.

# CHESSGPT_BIND=127.0.0.1:8080
# CHESSGPT_DATA_DIR=/data
# STOCKFISH_PATH=/opt/stockfish/stockfish
# ENGINE_WORKERS=2
# ENGINE_THREADS=4
# ENGINE_HASH_MB=256

# Hosted mode: user accounts (email or Lichess), the MCP connector for
# Claude/ChatGPT, and OAuth. PUBLIC_URL is required for the connector.
# CHESSGPT_MODE=hosted
# CHESSGPT_PUBLIC_URL=https://chessgpt.com

# The site's own AI model for the on-site coach (users never enter keys).
# Either a plain provider key...
# ANTHROPIC_API_KEY=sk-ant-...
# ...or explicitly:
# CHESSGPT_LLM_PROVIDER=anthropic        # anthropic | openai | openrouter | ollama | openai_compatible
# CHESSGPT_LLM_API_KEY=...
# CHESSGPT_LLM_MODEL=claude-opus-5
# CHESSGPT_LLM_BASE_URL=
# CHESSGPT_LLM_DAILY_TOKENS=5000000      # daily cap across all users

# ChatGPT plugin directory domain verification token.
# CHESSGPT_OPENAI_CHALLENGE=

# RUST_LOG=info
